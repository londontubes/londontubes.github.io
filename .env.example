# Public (exposed to the browser at build time)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 Measurement ID (looks like: G-XXXXXXXXXX)
# Preferred name:
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Back-compat (older name still supported by the code):
NEXT_PUBLIC_GA_ID=

# Google Search Console verification (optional)
# Paste the token value from the meta tag (no quotes)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Affiliate links (optional)
NEXT_PUBLIC_GYG_HEATHROW_EXPRESS_AFFILIATE_URL=

# Amazon Associates UK tracking tag (e.g. yourstore-21). Appended to
# amazon.co.uk search/product URLs so commissions are attributed.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Amber student housing affiliate URLs — one per university.
# Sign up at https://amberstudent.com/affiliates to get your tracking links.
# Each URL should be your affiliate link pointed at the relevant university page,
# e.g. https://amberstudent.com/places/university-college-london?ref=YOUR_CODE
NEXT_PUBLIC_AMBER_UCL_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_IMPERIAL_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_LSE_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_KINGS_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_QMUL_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_CITY_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_SOAS_AFFILIATE_URL=
NEXT_PUBLIC_AMBER_WESTMINSTER_AFFILIATE_URL=

# Server-only (optional)
TFL_APP_ID=
TFL_APP_KEY=
