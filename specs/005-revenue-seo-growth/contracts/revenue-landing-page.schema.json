{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://londontubes.co.uk/schemas/revenue-landing-page.schema.json",
  "title": "RevenueLandingPage",
  "type": "object",
  "required": [
    "slug",
    "pageType",
    "intentSegment",
    "title",
    "metaDescription",
    "canonicalPath",
    "primaryKeywords",
    "monetizationSurfaceIds",
    "publishState"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "pageType": {
      "type": "string",
      "enum": ["home", "blog", "university", "landing"]
    },
    "intentSegment": {
      "type": "string",
      "enum": ["housing", "student-accommodation", "commute", "travel-upgrade"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "metaDescription": {
      "type": "string",
      "minLength": 1
    },
    "canonicalPath": {
      "type": "string",
      "pattern": "^/.*"
    },
    "primaryKeywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relatedUniversityIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relatedStationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "monetizationSurfaceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publishState": {
      "type": "string",
      "enum": ["draft", "published", "noindex"]
    }
  },
  "additionalProperties": false
}