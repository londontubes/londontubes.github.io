{
  "name": "london-tube-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:validate",
    "build": "npm run data:refresh && next build",
    "start": "next start",
    "test": "jest",
    "start:static": "npx serve@latest out",
    "lint": "next lint",
    "rightmove:enrich": "tsx scripts/enrich-rightmove-station-template.ts",
    "verify:property-links": "tsx scripts/verify-property-search-results.ts",
    "verify:tube-times": "tsx scripts/verify-static-tube-times.ts",
    "audit:accessibility": "lighthouse-ci autorun",
    "data:refresh": "tsx scripts/data/fetch-tfl.ts && tsx scripts/data/transform.ts",
    "data:validate": "tsx scripts/data/validate.ts"
  },
  "dependencies": {
    "@types/leaflet": "1.9.8",
    "axios": "1.13.2",
    "leaflet": "1.9.4",
    "next": "^14.2.0",
    "nodemailer": "7.0.12",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-leaflet": "4.2.1",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "29.5.14",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "7.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.4.9",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.x"
  }
}
